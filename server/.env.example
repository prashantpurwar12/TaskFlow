# ── Required ─────────────────────────────────────────────────────────────────
# MongoDB connection string (use Atlas URI for production)
MONGODB_URI=mongodb://127.0.0.1:27017/team_task_manager

# JWT secret — MUST be a strong random 64-char string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (for CORS)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# JWT token expiry (default: 7d)
# JWT_EXPIRES_IN=7d
